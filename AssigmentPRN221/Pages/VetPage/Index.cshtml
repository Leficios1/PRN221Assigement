@page
@using BussinessObject.Model.ENUM;
@model AssigmentPRN221.Pages.VetPage.IndexModel

@{
    ViewData["Title"] = "All Bookings";
    ViewData["IsIndexPage"] = true;
    Layout = "_vetLayout";
}

<style>
    .booking-container {
        margin-top: 50px;
    }

    .booking-card {
        border: 1px solid #ddd;
        border-radius: 5px;
        padding: 20px;
        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
    }

    .booking-header {
        background-color: #f8f9fa;
        padding: 15px;
        border-bottom: 1px solid #ddd;
        border-radius: 5px 5px 0 0;
    }

    .booking-body {
        padding: 20px;
    }

    .booking-footer {
        background-color: #f8f9fa;
        padding: 15px;
        border-top: 1px solid #ddd;
        border-radius: 0 0 5px 5px;
        text-align: right;
    }

        .booking-footer a {
            margin-left: 10px;
        }

    .table th, .table td {
        text-align: center;
        vertical-align: middle;
    }

    .table th {
        background-color: darkblue;
    }
</style>

<div class="container booking-container">
    <h1 class="mb-4">@ViewData["Title"]</h1>

    <div class="booking-card">
        <div class="booking-header">
            <h4 class="card-title">All Bookings</h4>
        </div>
        <div class="booking-body">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Booking ID</th>
                        <th>Date</th>
                        <th>Status</th>
                        <th>Note</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Bookings)
                    {
                        <tr>
                            <td>@item.BookingId</td>
                            <td>@item.Date.ToString("MM/dd/yyyy")</td>
                            <td>
                                @{
                                    var status = (StatusEnum)item.Status;
                                    var statusClass = status switch
                                    {
                                        StatusEnum.inactive => "text-danger",
                                        StatusEnum.active => "text-success",
                                        StatusEnum.inProcess => "text-warning",
                                        _ => ""
                                    };
                                }
                                <span class="@statusClass">@status.ToDisplayBooking()</span>
                            </td>
                            <td>@item.Note</td>
                            <td>
                                <a asp-page="./Details/Index" asp-route-id="@item.BookingId" class="btn btn-info btn-details">Details</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
