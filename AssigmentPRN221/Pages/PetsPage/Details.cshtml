@page
@model AssigmentPRN221.Pages.PetsPage.DetailsModel

@{
    ViewData["Title"] = "Pet Details";
    Layout = "_userLayout";
}
<style>
    .pet-details {
    margin-top: 20px;
}

.pet-details dl {
    font-size: 1.1em;
}

.pet-details dt {
    font-weight: bold;
}

.pet-details dd {
    margin-bottom: 10px;
}

.pet-details img {
    max-width: 100%;
    height: auto;
    border: 1px solid #ddd;
    padding: 5px;
    background: #fff;
}

.pet-details .btn {
    margin-right: 10px;
}


</style>
<h1>Pet Details</h1>

<div class="pet-details">
    <div class="row">
        <div class="col-md-6">
            <dl class="row">
                <dt class="col-sm-4">Pet Name</dt>
                <dd class="col-sm-8">@Model.Pet.PetName</dd>

                <dt class="col-sm-4">Pet Type</dt>
                <dd class="col-sm-8">@Model.Pet.PetType</dd>

                <dt class="col-sm-4">Birth Date</dt>
                <dd class="col-sm-8">@Model.Pet.BirthDate.ToString("d")</dd>

                <dt class="col-sm-4">Pet Gender</dt>
                <dd class="col-sm-8">@Model.Pet.PetGender</dd>

                <dt class="col-sm-4">Special Features</dt>
                <dd class="col-sm-8">@Model.Pet.PetSecialFeatures</dd>
            </dl>
        </div>
    </div>
    <div class="mt-3">
        <a asp-page="./Edit" asp-route-id="@Model.Pet.Id" class="btn btn-primary">Edit</a>
        <a asp-page="./Index" class="btn btn-secondary">Back to List</a>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
