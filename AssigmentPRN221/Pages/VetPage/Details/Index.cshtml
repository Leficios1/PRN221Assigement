@page "{id:int}"
@model AssigmentPRN221.Pages.VetPage.Details.IndexModel
@{
    ViewData["Title"] = "Booking Details";
    Layout = "_vetLayout";
}

<style>
    .details-container {
        margin-top: 50px;
    }

    .details-card {
        border: 1px solid #ddd;
        border-radius: 5px;
        padding: 20px;
        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
    }

    .details-header {
        background-color: #f8f9fa;
        padding: 15px;
        border-bottom: 1px solid #ddd;
        border-radius: 5px 5px 0 0;
    }

    .details-body {
        padding: 20px;
    }

    .details-footer {
        background-color: #f8f9fa;
        padding: 15px;
        border-top: 1px solid #ddd;
        border-radius: 0 0 5px 5px;
        text-align: right;
    }

        .details-footer a {
            margin-left: 10px;
        }

    dt {
        font-weight: bold;
    }

    .table th, .table td {
        text-align: center;
        vertical-align: middle;
    }

    .table th {
        background-color: #f8f9fa;
    }
</style>

<div class="container details-container">
    <div class="details-card">
        <div class="details-header">
            <h4 class="card-title">Booking</h4>
        </div>
        <div class="details-body">
            <dl class="row mb-0">
                <dt class="col-sm-2">
                    User Name
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.BookingResponseDTO.UserName)
                </dd>
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.BookingResponseDTO.Date)
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.BookingResponseDTO.Date)
                </dd>
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.BookingResponseDTO.Status)
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.BookingResponseDTO.Status)
                </dd>
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.BookingResponseDTO.Note)
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.BookingResponseDTO.Note)
                </dd>
            </dl>
        </div>
    </div>

    <div class="details-card mt-4">
        <div class="details-header">
            <h4 class="card-title">Booking Details</h4>
        </div>
        <div class="details-body">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>
                            @Html.DisplayNameFor(model => model.BookingResponseDTO.bookingDetails[0].PetName)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.BookingResponseDTO.bookingDetails[0].VetName)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.BookingResponseDTO.bookingDetails[0].ServiceName)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.BookingResponseDTO.bookingDetails[0].Price)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.BookingResponseDTO.bookingDetails[0].Status)
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.BookingResponseDTO.bookingDetails)
                    {
                        <tr>
                            <td>
                                @Html.DisplayFor(modelItem => item.PetName)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.VetName)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.ServiceName)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Price)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Status)
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="details-footer mt-4">
        <a class="btn btn-secondary" asp-page="/VetPage/Index">Back to List</a>
    </div>
</div>
