@page
@model AssigmentPRN221.Pages.KennelPage.DetailsModel

@{
    ViewData["Title"] = "Details";
    Layout = "_StaffLayout";
}

<h1>Details</h1>

<div>
    <h4>Kennel Information</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Kennel.Name)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Kennel.Name)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Kennel.RoomNumber)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Kennel.RoomNumber)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Kennel.Capacity)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Kennel.Capacity)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Kennel.status)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Kennel.status)
        </dd>
    </dl>
</div>

@if (Model.KennelRecord?.PetName != null)
{
    <div>
        <h4>Pet Information</h4>
        <hr />
        <dl class="row">
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.KennelRecord.PetName)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.KennelRecord.PetName)
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.KennelRecord.CheckInDate)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.KennelRecord.CheckInDate)
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.KennelRecord.CheckOutDate)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.KennelRecord.CheckOutDate)
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.KennelRecord.Treatment)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.KennelRecord.Treatment)
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.KennelRecord.status)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.KennelRecord.status)
            </dd>
        </dl>
    </div>

    <div class="mt-3">
        <button type="button" class="btn btn-danger" data-toggle="modal" data-target="#checkoutModal">Checkout</button>
    </div>
}

<div>
    <a asp-page="./Edit" asp-route-id="@Model.Kennel?.KennelId">Edit</a> |
    <a asp-page="./KennelWelcom">Back to List</a>
</div>

<!-- Modal -->
<div class="modal fade" id="checkoutModal" tabindex="-1" role="dialog" aria-labelledby="checkoutModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="checkoutModalLabel">Confirm Checkout</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                Are you sure you want to checkout this kennel?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                <form method="post" asp-page-handler="Checkout">
                    <input type="hidden" name="id" value="@Model.Kennel.KennelId" />
                    <button type="submit" class="btn btn-danger">Confirm Checkout</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.3.1/jquery.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/js/bootstrap.min.js"></script>
}
