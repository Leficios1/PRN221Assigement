@page
@model AssigmentPRN221.Pages.UserModel
@{
    ViewData["IsIndexPage"] = true;
    <h1>Users List</h1>

    <style>
        .role-admin {
            color: #e74c3c;
            font-weight: bold;
        }

        .role-staff {
            color: #3498db;
            font-weight: bold;
        }

        .role-customer {
            color: #2ecc71;
            font-weight: bold;
        }

        .role-vet {
            color: #f39c12;
            font-weight: bold;
        }
    </style>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Email</th>
                <th>Phone</th>
                <th>Address</th>
                <th>Date Of Birth</th>
                <th>Gender</th>
                <th>Status</th>
                <th>Role</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model.Users)
            {
                <tr>
                    <td>@user.Id</td>
                    <td>@user.Name</td>
                    <td>@user.Email</td>
                    <td>@user.Phone</td>
                    <td>@user.Address</td>
                    <td>@user.DateOfBirth?.ToString("yyyy-MM-dd")</td>
                    <td>@user.Gender</td>
                    <td>@user.Status</td>
                    <td>
                        @{
                            string roleClass = "";
                            string roleName = "";
                            switch (user.RoleId)
                            {
                                case 1:
                                    roleClass = "role-admin";
                                    roleName = "Admin";
                                    break;
                                case 2:
                                    roleClass = "role-staff";
                                    roleName = "Staff";
                                    break;
                                case 3:
                                    roleClass = "role-customer";
                                    roleName = "Customer";
                                    break;
                                case 4:
                                    roleClass = "role-vet";
                                    roleName = "Vet";
                                    break;
                                default:
                                    roleName = "Unknown";
                                    break;
                            }
                        }
                        <span class="@roleClass">@roleName</span>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}