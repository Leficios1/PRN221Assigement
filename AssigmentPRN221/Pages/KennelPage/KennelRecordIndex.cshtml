@page
@model AssigmentPRN221.Pages.KennelPage.KennelRecordIndexModel

@{
    ViewData["IsIndexPage"] = true;
    Layout = "_StaffLayout";
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
</head>
<body>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.KennelRecord[0].PetName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.KennelRecord[0].KennelName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.KennelRecord[0].CheckInDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.KennelRecord[0].CheckOutDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.KennelRecord[0].Treatment)
            </th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.KennelRecord) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.PetName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.KennelName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CheckInDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CheckOutDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Treatment)
            </td>
        </tr>
}
    </tbody>
</table>
</body>
</html>
