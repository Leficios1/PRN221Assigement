@page
@model AssigmentPRN221.Pages.BookingPage.DetailsPage.Kennel.AddKennelModel
@{
    ViewData["Title"] = "Add Kennel";
    Layout = "_StaffLayout";
}

<h1>Add Kennel</h1>

<form method="post">
    <input type="hidden" asp-for="KennelRecord.PetId" />
    <div class="form-group">
        <label for="KennelId">Select Kennel</label>
        <select id="KennelId" asp-for="KennelRecord.KennelId" class="form-control" asp-items="Model.Kennels"></select>
    </div>
    <div class="form-group">
        <label asp-for="KennelRecord.Treatment" class="control-label"></label>
        <input asp-for="KennelRecord.Treatment" class="form-control" />
        <span asp-validation-for="KennelRecord.Treatment" class="text-danger"></span>
    </div>
    <input type="submit" value="Save" class="btn btn-primary" />
</form>
@if (ViewData["Message"] != null)
{
    <p>@ViewData["Message"]</p>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
