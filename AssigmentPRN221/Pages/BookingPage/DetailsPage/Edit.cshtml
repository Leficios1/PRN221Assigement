@page
@model AssigmentPRN221.Pages.BookingPage.DetailsPage.EditModel

@{
    ViewData["Title"] = "Edit";
    Layout = "_StaffLayout";

}

<h1>Edit</h1>

<h4>BookingDetails</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="BookingDetails.Id" />
            <div class="form-group">
                <label asp-for="BookingDetails.PetId" class="control-label"></label>
                <select asp-for="BookingDetails.PetId" class="form-control" asp-items="ViewBag.PetId"></select>
                <span asp-validation-for="BookingDetails.PetId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="BookingDetails.VetId" class="control-label"></label>
                <select asp-for="BookingDetails.VetId" class="form-control" asp-items="ViewBag.VetId"></select>
                <span asp-validation-for="BookingDetails.VetId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="BookingDetails.BookingId" class="control-label"></label>
                <select asp-for="BookingDetails.BookingId" class="form-control" asp-items="ViewBag.BookingId"></select>
                <span asp-validation-for="BookingDetails.BookingId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="BookingDetails.ServiceId" class="control-label"></label>
                <select asp-for="BookingDetails.ServiceId" class="form-control" asp-items="ViewBag.ServiceId"></select>
                <span asp-validation-for="BookingDetails.ServiceId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="BookingDetails.Price" class="control-label"></label>
                <input asp-for="BookingDetails.Price" class="form-control" />
                <span asp-validation-for="BookingDetails.Price" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="BookingDetails.Status" class="control-label"></label>
                <input asp-for="BookingDetails.Status" class="form-control" />
                <span asp-validation-for="BookingDetails.Status" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="./Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
