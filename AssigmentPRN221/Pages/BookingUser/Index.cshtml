@page
@using BussinessObject.Model.ENUM;
@model AssigmentPRN221.Pages.BookingUser.IndexModel

@{
    ViewData["Title"] = "Index";
    ViewData["IsIndexPage"] = true;
    Layout = "_userLayout";

}

<h1>History Booking </h1>

<p>
    <a asp-page="./DetailsPageUser/Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Booking[0].Date)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Booking[0].Status)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Booking[0].Note)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Booking)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Date)
                </td>
                <td>
                    @{
                        var status = (StatusEnum)item.Status;
                        var statusClass = status switch
                        {
                            StatusEnum.inactive => "text-danger",
                            StatusEnum.active => "text-success",
                            StatusEnum.inProcess => "text-warning",
                            _ => ""
                        };
                    }
                    <span class="@statusClass">@status.ToDisplayBooking()</span>
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Note)
                </td>
                <td>
                    <a asp-page="./DetailsPageUser/Index" asp-route-id="@item.BookingId">Details</a>
                </td>
            </tr>
        }
    </tbody>
</table>